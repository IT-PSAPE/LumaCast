{
  "name": "@lumacast/cloud",
  "version": "0.1.3",
  "private": true,
  "description": "LumaCloud: the suite manager that installs, updates, downgrades, and removes the LumaCast apps.",
  "license": "UNLICENSED",
  "author": "IT-PSAPE",
  "repository": {
    "type": "git",
    "url": "https://github.com/IT-PSAPE/LumaCast.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node script/dev.mjs dev",
    "build": "electron-vite build",
    "preview": "node script/dev.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@lumacast/desktop": "file:../../packages/desktop",
    "@lumacast/kernel": "file:../../packages/kernel",
    "@lumacast/selection": "file:../../packages/selection",
    "@lumacast/suite": "file:../../packages/suite",
    "@lumacast/ui": "file:../../packages/ui",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.13.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.10.2",
    "electron-builder": "^26.15.0",
    "electron-vite": "^3.1.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.2",
    "vite": "6.4.5"
  }
}
