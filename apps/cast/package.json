{
  "name": "@lumacast/cast",
  "version": "0.1.29",
  "productName": "LumaCast",
  "private": true,
  "description": "LumaCast: the cross-platform presentation desktop app with NDI output.",
  "author": "IT-PSAPE",
  "license": "UNLICENSED",
  "homepage": "https://github.com/IT-PSAPE/LumaCast#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/IT-PSAPE/LumaCast.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@11.6.2",
  "main": "out/main/index.js",
  "scripts": {
    "ensure:native-deps": "node ../../scripts/ensure-rollup-native.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "predev": "npm run ensure:native-deps",
    "dev": "electron-vite dev",
    "prebuild": "npm run ensure:native-deps",
    "build": "electron-vite build",
    "prepreview": "npm run ensure:native-deps",
    "preview": "electron-vite preview",
    "prepack": "npm run ensure:native-deps",
    "pack": "electron-vite build && electron-builder --dir",
    "predist": "npm run ensure:native-deps",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lobehub/icons-static-svg": "^1.95.0",
    "@lumacast/automation": "file:../../packages/automation",
    "@lumacast/canvas": "file:../../packages/canvas",
    "@lumacast/commands": "file:../../packages/commands",
    "@lumacast/composition": "file:../../packages/composition",
    "@lumacast/engine": "file:../../packages/engine",
    "@lumacast/kernel": "file:../../packages/kernel",
    "@lumacast/markers": "file:../../packages/markers",
    "@lumacast/ndi-native": "file:../../packages/ndi-native",
    "@lumacast/persistence-sqlite": "file:../../packages/persistence-sqlite",
    "@lumacast/playback": "file:../../packages/playback",
    "@lumacast/protocol": "file:../../packages/protocol",
    "@lumacast/ui": "file:../../packages/ui",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tanstack/react-virtual": "^3.13.24",
    "electron-updater": "^6.8.3",
    "konva": "^10.2.0",
    "lucide-react": "^1.7.0",
    "mammoth": "^1.12.3",
    "music-metadata": "^11.12.3",
    "openai": "^7.15.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-konva": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.13.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "35.7.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.2",
    "vite": "^5.4.14"
  }
}
