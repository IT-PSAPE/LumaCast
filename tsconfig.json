{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "electron"],
    "baseUrl": ".",
    "paths": {
      "@core/*": ["app/core/*"],
      "@database/*": ["app/database/*"],
      "@renderer/*": ["app/renderer/*"],
      "@lumacast/kernel": ["packages/kernel/src/index.ts"],
      "@lumacast/composition": ["packages/composition/src/index.ts"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "benchmarks/**/*.ts",
    "packages/**/*.ts"
  ]
}
